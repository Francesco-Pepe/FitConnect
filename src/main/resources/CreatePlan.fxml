<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.CreatePlanGraphicControllerGUI">
    <children>

        <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1200.0" spacing="12.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            <children>
                <Circle fill="#6345ff" radius="16.0" />
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="FitConnect" textFill="#1e293b">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Create Training Plan" textFill="#64748b">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </children>
                </VBox>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#backToDashboard" style="-fx-background-color: transparent; -fx-cursor: hand;" text="← Back to Dashboard" textFill="#334155">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>

        <VBox alignment="CENTER" layoutY="70.0" prefHeight="680.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <children>

                <VBox maxWidth="800.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5); -fx-padding: 40;">
                    <children>

                        <Label text="New Training Plan" textFill="#0f172a">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>

                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Athlete Name" textFill="#475569">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <TextField fx:id="athleteNameField" editable="false" prefHeight="45.0" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-text-fill: #64748b;" text="John Smith" />
                                    </children>
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Start Date" textFill="#475569">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <DatePicker fx:id="startDatePicker" maxWidth="Infinity" prefHeight="45.0" promptText="Seleziona data" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="Expire Date" textFill="#475569">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <DatePicker fx:id="expireDatePicker" maxWidth="Infinity" prefHeight="45.0" promptText="Seleziona data" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;" />
                            </children>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Weekly Exercises" textFill="#0f172a">
                                            <font><Font name="System Bold" size="18.0" /></font>
                                        </Label>
                                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#addExercise" style="-fx-background-color: transparent; -fx-cursor: hand;" text="+ Add Exercise" textFill="#6345ff">
                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <ScrollPane fitToWidth="true" maxHeight="180.0" minHeight="80.0" style="-fx-background-color: transparent; -fx-background: white;">
                                    <content>
                                        <VBox fx:id="exercisesContainer" spacing="10.0">
                                            <padding>
                                                <Insets bottom="5.0" left="2.0" right="15.0" top="5.0" />
                                            </padding>

                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <HBox spacing="15.0" style="-fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#createPlan" prefHeight="48.0" style="-fx-background-color: #6345ff; -fx-background-radius: 8; -fx-cursor: hand;" text="💾 Create Plan" textFill="white" HBox.hgrow="ALWAYS">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#backToDashboard" prefHeight="48.0" prefWidth="100.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancel" textFill="#334155">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
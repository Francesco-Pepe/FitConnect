<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="750.0" prefWidth="1000.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.ViewPlanControllerGUI">
    <children>
        <!-- Top Navigation Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1000.0" spacing="10.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="50.0" right="50.0" />
            </padding>
            <children>
                <Circle fill="#6345ff" radius="15.0" />
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="FitConnect" textFill="#333333">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Training Plan Completo" textFill="#888888">
                            <font><Font size="10.0" /></font>
                        </Label>
                    </children>
                </VBox>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#backToDashboard" style="-fx-background-color: transparent;" text="← Back to Dashboard" textFill="#333333" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- SCROLLPANE per gestire la lunghezza variabile -->
        <ScrollPane fitToWidth="true" layoutY="60.0" prefHeight="690.0" prefWidth="1000.0" style="-fx-background-color: transparent; -fx-background: #f4f7f6;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <content>
                <VBox alignment="TOP_CENTER" spacing="0.0">
                    <padding>
                        <Insets bottom="40.0" left="100.0" right="100.0" top="30.0" />
                    </padding>
                    <children>

                        <!-- app.Main Card -->
                        <VBox maxWidth="800.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                            <children>
                                <!-- Header Viola -->
                                <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #9333ea; -fx-background-radius: 15 15 0 0;">
                                    <padding><Insets left="25.0" /></padding>
                                    <children>
                                        <Label text="Your Complete Training Plan" textFill="white">
                                            <font><Font name="System Bold" size="18.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                                <VBox spacing="25.0" style="-fx-padding: 25;">
                                    <children>
                                        <!-- Row dei Box Informativi -->
                                        <HBox spacing="15.0">
                                            <children>
                                                <VBox prefHeight="70.0" prefWidth="240.0" style="-fx-background-color: #f0f4ff; -fx-background-radius: 10; -fx-padding: 12;">
                                                    <children>
                                                        <Label style="-fx-font-size: 11;" text="Trainer" textFill="#888888" />
                                                        <Label style="-fx-font-weight: bold;" text="Sarah Johnson" textFill="#333333" fx:id="trainerLabel"/>
                                                    </children>
                                                </VBox>
                                                <VBox prefHeight="70.0" prefWidth="240.0" style="-fx-background-color: #f0fff4; -fx-background-radius: 10; -fx-padding: 12;">
                                                    <children>
                                                        <Label style="-fx-font-size: 11;" text="Start Date" textFill="#888888" />
                                                        <Label style="-fx-font-weight: bold;" text="2026-05-12" textFill="#333333" fx:id="creationLabel"/>
                                                    </children>
                                                </VBox>
                                                <VBox prefHeight="70.0" prefWidth="240.0" style="-fx-background-color: #fff5f5; -fx-background-radius: 10; -fx-padding: 12;">
                                                    <children>
                                                        <Label style="-fx-font-size: 11;" text="Expire Date" textFill="#888888" />
                                                        <Label style="-fx-font-weight: bold;" text="2026-07-07" textFill="#333333" fx:id="expirationLabel"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Sezione Lista Esercizi -->
                                        <VBox spacing="15.0" style="-fx-border-color: #eeeeee; -fx-border-width: 1 0 0 0; -fx-padding: 15 0 0 0;">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="All Exercises (9)" fx:id="exerciseNumber"/>

                                                <!-- Esercizi (ne ho messi 9 per mostrare lo scorrimento) -->
                                                <VBox spacing="10.0" fx:id="exerciseContainer">

                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

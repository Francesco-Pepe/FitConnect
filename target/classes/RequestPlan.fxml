<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1000.0" spacing="0.0" style="-fx-background-color: #f3f4f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.RequestPlanGraphicGraphicControllerGUI">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets left="40.0" right="40.0" />
        </padding>
        <Label style="-fx-font-weight: bold; -fx-text-fill: #4f46e5;" text="FitConnect">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
        <Label style="-fx-text-fill: #6b7280;" text="  Request Training Plan">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #374151;" text="← Back to Dashboard" onAction="#returnToDashboard" />
    </HBox>

    <!-- MAIN CONTENT AREA -->
    <StackPane VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="40.0" top="40.0" />
        </padding>

        <!-- THE CARD -->
        <VBox maxWidth="700.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <Label style="-fx-font-weight: bold; -fx-text-fill: #111827;" text="New Plan Request">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>

            <!-- SELECTION: TRAINER -->
            <VBox spacing="8.0">
                <Label style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Select Personal Trainer" />
                <ComboBox fx:id="trainerComboBox" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="Choose a trainer..." style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8;" />
            </VBox>

            <!-- SELECTION: GOALS -->
            <VBox spacing="8.0">
                <Label style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Select Your Fitness Goals" />
                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>

                    <fx:define>
                        <ToggleGroup fx:id="fitnessGoalGroup" />
                    </fx:define>

                    <RadioButton toggleGroup="$fitnessGoalGroup" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="50.0" styleClass="goal-button" text="Weight Loss" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <RadioButton toggleGroup="$fitnessGoalGroup" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="50.0" styleClass="goal-button" text="Improve Strength" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <RadioButton toggleGroup="$fitnessGoalGroup" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="50.0" styleClass="goal-button" text="Body Recomposition" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- ADDITIONAL NOTES -->
            <VBox spacing="8.0">
                <Label style="-fx-text-fill: #374151; -fx-font-weight: bold;" text="Additional Notes (Optional)" />
                <TextArea fx:id="notesArea" prefHeight="120.0" promptText="Any additional information, experience level, available equipment..." style="-fx-border-color: #d1d5db; -fx-border-radius: 8;" wrapText="true" />
            </VBox>

            <!-- ACTIONS -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button fx:id="sendRequestBtn" onAction="#handleSendRequest" prefHeight="50.0" prefWidth="400.0" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="✈ Send Request">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
                <Button fx:id="cancelBtn" onAction="#handleCancel" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-text-fill: #374151;" text="Cancel" />
            </HBox>

        </VBox>
    </StackPane>
</VBox>